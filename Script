
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local defaults = {
	UIGradientPlus = {
		colorKeypoints = {
			{0, Color3.new(1, 1, 1)},
			{1, Color3.new(1, 1, 1)},
		},

		transparencyKeypoints = {
			{0, 0},
			{1, 0},
		},

		scaleValue = 1,
		offsetValue = 0,

		looped = false,

		Rotation = 0,
		Enabled = true,
		Name = "UIGradient",
	},

	UIGradientPlusAnimation = {
		animationType = "Loop",

		duration = -1,
		speed = 1,

		easingSpeed = 1,
		easingStyle = Enum.EasingStyle.Linear,
		easingDirection = Enum.EasingDirection.In,
	},

	Colors = {
		White = Color3.fromRGB(255, 255, 255),
		Gray = Color3.fromRGB(128, 128, 128),
		Black = Color3.fromRGB(0, 0, 0),

		Red = Color3.fromRGB(255, 0, 0),
		Orange = Color3.fromRGB(255, 128, 0),
		Yellow = Color3.fromRGB(255, 255, 0),

		Green = Color3.fromRGB(0, 255, 0),
		Cyan = Color3.fromRGB(0, 255, 255),
		Blue = Color3.fromRGB(0, 0, 255),

		Purple = Color3.fromRGB(128, 0, 255),
		Pink = Color3.fromRGB(255, 0, 255),
	},
}

export type UIGradientPlusProps = {
	colorKeypoints: {[number]: {[number]: Color3 | string}}?,
	transparencyKeypoints: {[number]: {[number]: number}}?,

	offsetValue: number?,
	scaleValue: number?,

	looped: boolean?,

	Rotation: number?,
	Enabled: boolean?,
	Archivable: boolean?,
	Name: string?,
}

export type UIGradientPlusAnimationProps = {
	animationType: string?,

	duration: number?,
	speed: number?,

	easingSpeed: number?,
	easingStyle: Enum.EasingStyle?,
	easingDirection: Enum.EasingDirection?,
}

export type UIGradientPlusAnimation = {
	animationType: string,

	duration: number,
	speed: number,

	easingSpeed: number,
	easingTimes: number,

	easingStyle: Enum.EasingStyle,
	easingDirection: Enum.EasingDirection,

	startOffset: number,
	startRotation: number,

	progress: number,
	alpha: number,

	stopped: boolean?,
}

local UIGradientPlus = {}

local activeGradients = {}

--------------------------------------------------
-- Utilities
--------------------------------------------------

local function stringToColor(colorString: string): Color3
	return defaults.Colors[colorString] or Color3.new(1, 1, 1)
end

local function lerpColor(
	colorOne: Color3,
	colorTwo: Color3,
	alpha: number
): Color3
	return colorOne:Lerp(colorTwo, alpha)
end

local function lerpNumber(
	valueOne: number,
	valueTwo: number,
	alpha: number
): number
	return valueOne + (valueTwo - valueOne) * alpha
end

--------------------------------------------------
-- Keypoints
--------------------------------------------------

local function readKeypoints(
	keypoints,
	scale: number
)
	local result = {}

	scale = math.max(scale, 0.0001)

	for _, keypoint in keypoints do
		local value = keypoint[2]

		if type(value) == "string" then
			value = stringToColor(value)
		end

		table.insert(result, {
			Time = keypoint[1] * scale,
			Value = value,
		})
	end

	table.sort(result, function(a, b)
		return a.Time < b.Time
	end)

	return result
end

local function processKeypoints(
	keypoints,
	offset: number,
	lerpFunction,
	constructorFunction
)
	local result = {}

	if #keypoints == 0 then
		return result
	end

	local startTime = offset
	local endTime = offset + 1

	local first = keypoints[1]
	local last = keypoints[#keypoints]

	--------------------------------------------------
	-- Find first visible point
	--------------------------------------------------

	if startTime <= first.Time then
		table.insert(
			result,
			constructorFunction(
				0,
				first.Value
			)
		)
	else
		for i = 2, #keypoints do
			local previous = keypoints[i - 1]
			local current = keypoints[i]

			if startTime >= previous.Time
				and startTime <= current.Time then

				local alpha =
					(startTime - previous.Time)
					/ (current.Time - previous.Time)

				table.insert(
					result,
					constructorFunction(
						0,
						lerpFunction(
							previous.Value,
							current.Value,
							alpha
						)
					)
				)

				break
			end
		end
	end

	--------------------------------------------------
	-- Visible points
	--------------------------------------------------

	for _, keypoint in keypoints do
		if keypoint.Time > startTime
			and keypoint.Time < endTime then

			table.insert(
				result,
				constructorFunction(
					keypoint.Time - startTime,
					keypoint.Value
				)
			)
		end
	end

	--------------------------------------------------
	-- Find last visible point
	--------------------------------------------------

	if endTime >= last.Time then
		table.insert(
			result,
			constructorFunction(
				1,
				last.Value
			)
		)
	else
		for i = 2, #keypoints do
			local previous = keypoints[i - 1]
			local current = keypoints[i]

			if endTime >= previous.Time
				and endTime <= current.Time then

				local alpha =
					(endTime - previous.Time)
					/ (current.Time - previous.Time)

				table.insert(
					result,
					constructorFunction(
						1,
						lerpFunction(
							previous.Value,
							current.Value,
							alpha
						)
					)
				)

				break
			end
		end
	end

	return result
end

--------------------------------------------------
-- Constructor
--------------------------------------------------

function UIGradientPlus.new(
	properties: UIGradientPlusProps?,
	parent: Instance?
)
	properties = properties or {}

	for propertyName, propertyValue in defaults.UIGradientPlus do
		if properties[propertyName] == nil then
			properties[propertyName] = propertyValue
		end
	end

	local scaleValue =
		math.max(properties.scaleValue, 0.0001)

	local gradient = Instance.new("UIGradient")

	local self = {
		UIGradient = gradient,

		colorKeypoints = readKeypoints(
			properties.colorKeypoints,
			scaleValue
		),

		transparencyKeypoints = readKeypoints(
			properties.transparencyKeypoints,
			scaleValue
		),

		offsetValue = properties.offsetValue,
		scaleValue = scaleValue,

		looped = properties.looped,

		activeAnimations = {},
		removingAnimations = {},

		Rotation = properties.Rotation,
		Enabled = properties.Enabled,

		Archivable = properties.Archivable ~= false,
		Name = properties.Name,
	}

	--------------------------------------------------
	-- Initial UIGradient properties
	--------------------------------------------------

	gradient.Name = self.Name
	gradient.Enabled = self.Enabled
	gradient.Rotation = self.Rotation
	gradient.Archivable = self.Archivable

	gradient.Parent = parent

	--------------------------------------------------
	-- Initial gradient
	--------------------------------------------------

	local colors = processKeypoints(
		self.colorKeypoints,
		self.offsetValue,
		lerpColor,
		ColorSequenceKeypoint.new
	)

	local transparency = processKeypoints(
		self.transparencyKeypoints,
		self.offsetValue,
		lerpNumber,
		NumberSequenceKeypoint.new
	)

	if #colors >= 2 then
		gradient.Color = ColorSequence.new(colors)
	end

	if #transparency >= 2 then
		gradient.Transparency =
			NumberSequence.new(transparency)
	end

	local proxy

	proxy = setmetatable({}, {
		__index = function(_, key)
			if UIGradientPlus[key] then
				return UIGradientPlus[key]
			end

			if self[key] ~= nil then
				return self[key]
			end

			return gradient[key]
		end,

		__newindex = function(_, key, value)
			if self[key] ~= nil then
				self[key] = value

				if key == "Rotation" then
					gradient.Rotation = value
				elseif key == "Enabled" then
					gradient.Enabled = value
				elseif key == "Name" then
					gradient.Name = value
				elseif key == "Archivable" then
					gradient.Archivable = value
				end

				return
			end

			if key == "offsetValue" then
				self.offsetValue = value
				return
			end

			if key == "scaleValue" then
				self.scaleValue = math.max(value, 0.0001)
				return
			end

			gradient[key] = value
		end,

		__type = "UIGradientPlus",
	})

	activeGradients[proxy] = true

	return proxy
end

--------------------------------------------------
-- Update
--------------------------------------------------

function UIGradientPlus:UpdateGradient(deltaTime: number)

	if not self.Enabled then
		return
	end

	--------------------------------------------------
	-- Animations
	--------------------------------------------------

	for animation, enabled in self.activeAnimations do

		if enabled then

			animation.progress +=
				animation.speed * deltaTime

			--------------------------------------------------
			-- Duration
			--------------------------------------------------

			if animation.duration > 0
				and animation.progress >= animation.duration then

				self.activeAnimations[animation] = nil
				animation.stopped = true

				continue
			end

			--------------------------------------------------
			-- Loop animation
			--------------------------------------------------

			if animation.animationType == "Loop" then

				animation.alpha =
					TweenService:GetValue(
						animation.progress % 1,
						animation.easingStyle,
						animation.easingDirection
					)

				self:Loop(animation)

			elseif animation.animationType == "Scroll" then

				animation.alpha =
					TweenService:GetValue(
						animation.progress % 1,
						animation.easingStyle,
						animation.easingDirection
					)

				self:Scroll(animation)

			elseif animation.animationType == "Rotate" then

				animation.alpha =
					TweenService:GetValue(
						animation.progress % 1,
						animation.easingStyle,
						animation.easingDirection
					)

				self:Rotate(animation)
			end
		end
	end

	--------------------------------------------------
	-- Keep Rotation synced
	--------------------------------------------------

	self.UIGradient.Rotation = self.Rotation

	--------------------------------------------------
	-- Update visual gradient
	--------------------------------------------------

	if self._lastOffsetValue ~= self.offsetValue then

		local actualColorKeypoints =
			processKeypoints(
				self.colorKeypoints,
				self.offsetValue,
				lerpColor,
				ColorSequenceKeypoint.new
			)

		local actualTransparencyKeypoints =
			processKeypoints(
				self.transparencyKeypoints,
				self.offsetValue,
				lerpNumber,
				NumberSequenceKeypoint.new
			)

		if #actualColorKeypoints >= 2 then
			self.UIGradient.Color =
				ColorSequence.new(actualColorKeypoints)
		end

		if #actualTransparencyKeypoints >= 2 then
			self.UIGradient.Transparency =
				NumberSequence.new(actualTransparencyKeypoints)
		end

		self._lastOffsetValue =
			self.offsetValue
	end
end

--------------------------------------------------
-- Keypoint setters
--------------------------------------------------

function UIGradientPlus:SetColorKeypoints(
	colorKeypoints
)
	self.colorKeypoints =
		readKeypoints(
			colorKeypoints,
			self.scaleValue
		)

	self._lastOffsetValue =
		self.offsetValue - 1

	return self
end

function UIGradientPlus:SetTransparencyKeypoints(
	transparencyKeypoints
)
	self.transparencyKeypoints =
		readKeypoints(
			transparencyKeypoints,
			self.scaleValue
		)

	self._lastOffsetValue =
		self.offsetValue - 1

	return self
end

--------------------------------------------------
-- LOOP
--------------------------------------------------

function UIGradientPlus:Loop(
	animation: UIGradientPlusAnimation
)

	-- ÖNEMLİ:
	-- Artık keypointleri looplamıyoruz.
	-- Gradient'in kendi Offset property'sini kullanıyoruz.

	local offset =
		animation.startOffset
		+ animation.progress

	self.UIGradient.Offset =
		Vector2.new(
			offset % 1,
			0
		)
end

--------------------------------------------------
-- SCROLL
--------------------------------------------------

function UIGradientPlus:Scroll(
	animation: UIGradientPlusAnimation
)
	self:Loop(animation)
end

--------------------------------------------------
-- ROTATE
--------------------------------------------------

function UIGradientPlus:Rotate(
	animation: UIGradientPlusAnimation
)

	self.Rotation =
		(
			animation.startRotation
			+ animation.progress * 360
		) % 360

	self.UIGradient.Rotation =
		self.Rotation
end

function UIGradientPlus:ApplyAnimation(
	properties: UIGradientPlusAnimationProps?,
	animation: UIGradientPlusAnimation?
)

	if not animation then

		properties = properties or {}

		for propertyName, propertyValue
			in defaults.UIGradientPlusAnimation do

			if properties[propertyName] == nil then
				properties[propertyName] =
					propertyValue
			end
		end

		animation = {

			animationType =
				properties.animationType,

			duration =
				properties.duration,

			speed =
				properties.speed,

			easingSpeed =
				properties.easingSpeed,

			easingTimes =
				1 / math.max(
					properties.easingSpeed,
					0.0001
				),

			easingStyle =
				properties.easingStyle,

			easingDirection =
				properties.easingDirection,

			startOffset =
				self.offsetValue,

			startRotation =
				self.Rotation,

			progress = 0,

			alpha = 0,

			stopped = false,
		}
	end

	animation.stopped = false

	self.activeAnimations[animation] = true
	self.removingAnimations[animation] = nil

	if animation.duration > 0 then

		local currentAnimation =
			animation

		task.delay(
			animation.duration,
			function()

				if self.activeAnimations[currentAnimation] then

					self.activeAnimations[currentAnimation] = nil

					currentAnimation.stopped = true
				end
			end
		)
	end

	return animation
end

function UIGradientPlus:PauseAnimation(
	animation
)

	if self.activeAnimations[animation] ~= nil then
		self.activeAnimations[animation] = false
	end

	return self
end

function UIGradientPlus:ResumeAnimation(
	animation
)

	if self.activeAnimations[animation] ~= nil then
		self.activeAnimations[animation] = true
	end

	return self
end

function UIGradientPlus:RemoveAnimation(
	animation,
	completeFirst
)

	if completeFirst then
		self.removingAnimations[animation] = true
	else
		self.activeAnimations[animation] = nil
		self.removingAnimations[animation] = nil
	end

	return self
end

function UIGradientPlus:Destroy()

	activeGradients[self] = nil

	table.clear(self.activeAnimations)
	table.clear(self.removingAnimations)

	if self.UIGradient then
		self.UIGradient:Destroy()
	end
end

RunService.PostSimulation:Connect(
	function(deltaTime)

		for gradient in activeGradients do

			if gradient.UIGradient
				and gradient.UIGradient.Parent then

				gradient:UpdateGradient(deltaTime)

			else
				activeGradients[gradient] = nil
			end
		end
	end
)

return UIGradientPlus
