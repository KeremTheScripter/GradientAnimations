local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local defaults = {
	UIGradientPlus = {
		colorKeypoints = {
			{0, Color3.new(1, 1, 1)},
			{1, Color3.new(1, 1, 1)},
		},

		transparencyKeypoints = {
			{0, 0},
			{1, 0},
		},

		scaleValue = 1,
		offsetValue = 0,

		looped = false,

		Rotation = 0,
		Enabled = true,
		Name = "UIGradient",
	},

	UIGradientPlusAnimation = {
		animationType = "Loop",

		duration = -1,
		speed = 1,

		easingSpeed = 1,
		easingStyle = Enum.EasingStyle.Linear,
		easingDirection = Enum.EasingDirection.In,
	},

	Colors = {
		White = Color3.fromRGB(255, 255, 255),
		Gray = Color3.fromRGB(128, 128, 128),
		Black = Color3.fromRGB(0, 0, 0),

		Red = Color3.fromRGB(255, 0, 0),
		Orange = Color3.fromRGB(255, 128, 0),
		Yellow = Color3.fromRGB(255, 255, 0),

		Green = Color3.fromRGB(0, 255, 0),
		Cyan = Color3.fromRGB(0, 255, 255),
		Blue = Color3.fromRGB(0, 0, 255),

		Purple = Color3.fromRGB(128, 0, 255),
		Pink = Color3.fromRGB(255, 0, 255),
	},
}

local activeGradients = {}

export type UIGradientPlusProps = {
	colorKeypoints: {[number]: {[number]: Color3 | string}}?,
	transparencyKeypoints: {[number]: {[number]: number}}?,

	offsetValue: number?,
	scaleValue: number?,

	looped: boolean?,

	Rotation: number?,
	Enabled: boolean?,

	Archivable: boolean?,
	Name: string?,
}

export type UIGradientPlusAnimationProps = {
	animationType: string?,

	duration: number?,
	speed: number?,

	easingSpeed: number?,
	easingStyle: Enum.EasingStyle?,
	easingDirection: Enum.EasingDirection?,
}

export type UIGradientPlus = {
	UIGradient: UIGradient,

	colorKeypoints: {[number]: {Time: number, Value: Color3}},
	transparencyKeypoints: {[number]: {Time: number, Value: number}},

	offsetValue: number,
	scaleValue: number,

	_lastOffsetValue: number,

	looped: boolean,

	activeAnimations: {[UIGradientPlusAnimation]: boolean},
	removingAnimations: {[UIGradientPlusAnimation]: boolean},

	Rotation: number,
	Enabled: boolean,

	Archivable: boolean,
	Name: string,
	Parent: Instance?,

	new: (properties: UIGradientPlusProps, parent: Instance?) -> UIGradientPlus,

	UpdateGradient: (self: UIGradientPlus, deltaTime: number) -> (),

	SetColorKeypoints: (self: UIGradientPlus, colorKeypoints: {[number]: number | Color3 | string}) -> UIGradientPlus,
	SetTransparencyKeypoints: (self: UIGradientPlus, transparencyKeypoints: {[number]: number}) -> UIGradientPlus,

	ApplyAnimation: (self: UIGradientPlus, properties: UIGradientPlusAnimationProps?, animation: UIGradientPlusAnimation?) -> UIGradientPlusAnimation,

	PauseAnimation: (self: UIGradientPlus, animation: UIGradientPlusAnimation) -> UIGradientPlus,
	ResumeAnimation: (self: UIGradientPlus, animation: UIGradientPlusAnimation) -> UIGradientPlus,
	RemoveAnimation: (self: UIGradientPlus, animation: UIGradientPlusAnimation, completeFirst: boolean?) -> UIGradientPlus,

	Destroy: (self: UIGradientPlus) -> (),
}

export type UIGradientPlusAnimation = {
	animationType: string,

	duration: number,
	speed: number,

	easingSpeed: number,
	easingTimes: number,

	easingStyle: Enum.EasingStyle,
	easingDirection: Enum.EasingDirection,

	startOffset: number,
	startRotation: number,

	progress: number,
	alpha: number,

	stopped: boolean?,
}

local UIGradientPlus = {}

local function stringToColor(colorString: string): Color3
	return defaults.Colors[colorString] or Color3.new(1, 1, 1)
end

local function shallowCopy(originalTable: {[any]: any}): {[any]: any}
	local newTable = {}

	for index, value in originalTable do
		newTable[index] = value
	end

	return newTable
end

local function lerpColor(colorOne: Color3, colorTwo: Color3, alpha: number): Color3
	return colorOne:Lerp(colorTwo, alpha)
end

local function lerpNumber(valueOne: number, valueTwo: number, alpha: number): number
	return valueOne + (valueTwo - valueOne) * alpha
end

--[[
	Reads the user keypoints and prepares them for looping.

	When looped:
		- Original keypoints stay in their original range.
		- A copy is placed one cycle before.
		- A copy is placed one cycle after.

	This allows processKeypoints() to interpolate smoothly
	from the last color back into the first color.
]]
local function readKeypoints(
	keypoints: {[number]: {Color3 | string | number}},
	scale: number,
	looped: boolean
): {[number]: {Time: number, Value: Color3 | number}}

	local keypointsTable = {}

	scale = math.max(scale, 0.0001)

	for _, keypoint in keypoints do
		local value = keypoint[2]

		if type(value) == "string" then
			value = stringToColor(value)
		end

		table.insert(keypointsTable, {
			Time = keypoint[1] * scale,
			Value = value,
		})
	end

	table.sort(keypointsTable, function(keypointOne, keypointTwo)
		return keypointOne.Time < keypointTwo.Time
	end)

	if looped and #keypointsTable > 0 then
		local originalKeypoints = table.clone(keypointsTable)

		-- Previous cycle
		for _, keypoint in originalKeypoints do
			table.insert(keypointsTable, {
				Time = keypoint.Time - scale,
				Value = keypoint.Value,
			})
		end

		-- Next cycle
		for _, keypoint in originalKeypoints do
			table.insert(keypointsTable, {
				Time = keypoint.Time + scale,
				Value = keypoint.Value,
			})
		end

		table.sort(keypointsTable, function(keypointOne, keypointTwo)
			return keypointOne.Time < keypointTwo.Time
		end)
	end

	return keypointsTable
end

local function processKeypoints(
	keypoints: {[number]: {Time: number, Value: Color3 | number}},
	offset: number,
	lerpFunction,
	constructorFunction
): {[number]: ColorSequenceKeypoint | NumberSequenceKeypoint}

	local keypointsTable = {}

	local offsetStart = offset
	local offsetEnd = offset + 1

	for index, keypoint in ipairs(keypoints) do
		local time = keypoint.Time
		local value = keypoint.Value

		local lastKeypoint = keypoints[index - 1]

		-- Create a keypoint exactly at the beginning of the visible range.
		if lastKeypoint
			and lastKeypoint.Time < offsetStart
			and time > offsetStart then

			local alpha =
				(offsetStart - lastKeypoint.Time)
				/ (time - lastKeypoint.Time)

			table.insert(
				keypointsTable,
				constructorFunction(
					0,
					lerpFunction(lastKeypoint.Value, value, alpha)
				)
			)
		end

		-- Add keypoints inside the visible range.
		if time >= offsetStart and time <= offsetEnd then
			table.insert(
				keypointsTable,
				constructorFunction(
					time - offsetStart,
					value
				)
			)
		end

		-- Create a keypoint exactly at the end of the visible range.
		if lastKeypoint
			and lastKeypoint.Time < offsetEnd
			and time > offsetEnd then

			local alpha =
				(offsetEnd - lastKeypoint.Time)
				/ (time - lastKeypoint.Time)

			table.insert(
				keypointsTable,
				constructorFunction(
					1,
					lerpFunction(lastKeypoint.Value, value, alpha)
				)
			)

			break
		end
	end

	-- Safety fallback.
	if #keypointsTable == 0 then
		local firstKeypoint = keypoints[1]

		if firstKeypoint then
			table.insert(
				keypointsTable,
				constructorFunction(0, firstKeypoint.Value)
			)

			table.insert(
				keypointsTable,
				constructorFunction(1, firstKeypoint.Value)
			)
		end
	end

	return keypointsTable
end

function UIGradientPlus.new(
	properties: UIGradientPlusProps,
	parent: Instance?
): UIGradientPlus

	properties = properties or {}

	-- Apply defaults without overwriting explicit false/0 values.
	for propertyName, propertyValue in defaults.UIGradientPlus do
		if properties[propertyName] == nil then
			properties[propertyName] = propertyValue
		end
	end

	local scaleValue = math.max(properties.scaleValue, 0.0001)

	local self = {
		UIGradient = Instance.new("UIGradient"),

		offsetValue = properties.offsetValue,
		scaleValue = scaleValue,

		_lastOffsetValue = properties.offsetValue - 1,

		looped = properties.looped,

		colorKeypoints = readKeypoints(
			properties.colorKeypoints,
			scaleValue,
			properties.looped
		),

		transparencyKeypoints = readKeypoints(
			properties.transparencyKeypoints,
			scaleValue,
			properties.looped
		),

		activeAnimations = {},
		removingAnimations = {},
	}

	-- Apply actual UIGradient properties.
	for propertyName, propertyValue in properties do
		if pcall(function()
			local _ = self.UIGradient[propertyName]
		end) then
			self.UIGradient[propertyName] = propertyValue
		end
	end

	self.UIGradient.Parent = parent

	local proxy = setmetatable({}, {
		__index = function(_, key)
			return UIGradientPlus[key]
				or self[key]
				or self.UIGradient[key]
		end,

		__newindex = function(_, key, value)
			if self[key] ~= nil then
				self[key] = value

			elseif defaults.UIGradientPlus[key] ~= nil then
				self.UIGradient[key] = value

				if key == "offsetValue" then
					self._lastOffsetValue = value - 1
				end

			else
				rawset(self, key, value)
			end
		end,

		__type = "UIGradientPlus",
	})

	activeGradients[proxy] = true

	return proxy
end

function UIGradientPlus:UpdateGradient(deltaTime: number)

	for animation, enabled in self.activeAnimations do
		if enabled then

			-- Advance animation first.
			animation.progress += animation.speed * deltaTime

			-- Handle completed animations.
			if animation.progress >= 1 then

				if self.removingAnimations[animation] then
					self.activeAnimations[animation] = nil
					self.removingAnimations[animation] = nil

					continue
				end

				animation.progress %= 1
			end

			-- Calculate easing before applying the animation.
			animation.alpha = TweenService:GetValue(
				animation.progress,
				animation.easingStyle,
				animation.easingDirection
			)

			-- Apply animation.
			local animationFunction = UIGradientPlus[animation.animationType]

			if animationFunction then
				animationFunction(self, animation)
			end
		end
	end

	-- Only rebuild the ColorSequence when offset changed.
	if self._lastOffsetValue ~= self.offsetValue then

		local actualColorKeypoints = processKeypoints(
			self.colorKeypoints,
			self.offsetValue,
			lerpColor,
			ColorSequenceKeypoint.new
		)

		local actualTransparencyKeypoints = processKeypoints(
			self.transparencyKeypoints,
			self.offsetValue,
			lerpNumber,
			NumberSequenceKeypoint.new
		)

		if #actualColorKeypoints >= 2 then
			self.UIGradient.Color =
				ColorSequence.new(actualColorKeypoints)
		end

		if #actualTransparencyKeypoints >= 2 then
			self.UIGradient.Transparency =
				NumberSequence.new(actualTransparencyKeypoints)
		end

		self._lastOffsetValue = self.offsetValue
	end
end

function UIGradientPlus:SetColorKeypoints(
	colorKeypoints: {[number]: number | Color3 | string}
): UIGradientPlus

	self.colorKeypoints = readKeypoints(
		colorKeypoints,
		self.scaleValue,
		self.looped
	)

	self._lastOffsetValue = self.offsetValue - 1

	return self
end

function UIGradientPlus:SetTransparencyKeypoints(
	transparencyKeypoints: {[number]: number}
): UIGradientPlus

	self.transparencyKeypoints = readKeypoints(
		transparencyKeypoints,
		self.scaleValue,
		self.looped
	)

	self._lastOffsetValue = self.offsetValue - 1

	return self
end

--[[
	Scroll the gradient horizontally.

	Linear easing is recommended for seamless continuous motion.
]]
function UIGradientPlus:Loop(animation: UIGradientPlusAnimation)

	local scale = math.max(self.scaleValue, 0.0001)

	self.offsetValue =
		(animation.startOffset + animation.alpha * scale)
		% scale
end

-- Alias for a clearer API.
function UIGradientPlus:Scroll(animation: UIGradientPlusAnimation)
	self:Loop(animation)
end

function UIGradientPlus:Rotate(animation: UIGradientPlusAnimation)

	self.Rotation =
		(animation.startRotation + animation.alpha * 360)
		% 360
end

function UIGradientPlus:ApplyAnimation(
	properties: UIGradientPlusAnimationProps?,
	animation: UIGradientPlusAnimation?
): UIGradientPlusAnimation

	if not animation then

		properties = properties or {}

		for propertyName, propertyValue in defaults.UIGradientPlusAnimation do
			if properties[propertyName] == nil then
				properties[propertyName] = propertyValue
			end
		end

		animation = {
			animationType = properties.animationType,

			speed = properties.speed,
			duration = properties.duration,

			easingSpeed = properties.easingSpeed,
			easingTimes = 1 / math.max(properties.easingSpeed, 0.0001),

			easingStyle = properties.easingStyle,
			easingDirection = properties.easingDirection,

			startOffset = self.offsetValue,
			startRotation = self.Rotation,

			progress = 0,
			alpha = 0,

			stopped = false,
		}
	end

	animation.stopped = false

	self.activeAnimations[animation] = true
	self.removingAnimations[animation] = nil

	if animation.duration > 0 then

		local currentAnimation = animation

		task.delay(animation.duration, function()

			-- Don't stop a newer animation using the same object.
			if self.activeAnimations[currentAnimation] then
				self.activeAnimations[currentAnimation] = nil
				self.removingAnimations[currentAnimation] = nil

				currentAnimation.stopped = true
			end
		end)
	end

	-- Return the actual animation object.
	-- This is important for PauseAnimation/ResumeAnimation.
	return animation
end

function UIGradientPlus:PauseAnimation(
	animation: UIGradientPlusAnimation
): UIGradientPlus

	if self.activeAnimations[animation] ~= nil then
		self.activeAnimations[animation] = false
	end

	return self
end

function UIGradientPlus:ResumeAnimation(
	animation: UIGradientPlusAnimation
): UIGradientPlus

	if self.activeAnimations[animation] ~= nil then
		self.activeAnimations[animation] = true
	end

	return self
end

function UIGradientPlus:RemoveAnimation(
	animation: UIGradientPlusAnimation,
	completeFirst: boolean?
): UIGradientPlus

	if completeFirst then
		self.removingAnimations[animation] = true
	else
		self.activeAnimations[animation] = nil
		self.removingAnimations[animation] = nil
	end

	return self
end

function UIGradientPlus:Destroy()

	activeGradients[self] = nil

	if self.UIGradient then
		self.UIGradient:Destroy()
	end

	table.clear(self.activeAnimations)
	table.clear(self.removingAnimations)
	table.clear(self.colorKeypoints)
	table.clear(self.transparencyKeypoints)

	table.clear(self)

	setmetatable(self, nil)
end

RunService.PostSimulation:Connect(function(deltaTime)

	for gradient in activeGradients do
		gradient:UpdateGradient(deltaTime)
	end
end)

return UIGradientPlus
